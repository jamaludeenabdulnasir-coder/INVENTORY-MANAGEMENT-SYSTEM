# ===================================================
# KiliMax React Environment Variables (Vercel / Local)
# ===================================================

# URL of the hosted backend server on Render
# Note: You can provide either the domain (https://your-service.onrender.com)
# or the full API path (https://your-service.onrender.com/api).
# In local development, leaving this blank will default to '/api' which proxies to localhost:5000.
VITE_API_URL=https://your-backend-app.onrender.com/api
