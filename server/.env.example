# ===================================================
# KiliMax Server Environment Variables (Render / Local)
# ===================================================

# Port to listen on (Render provides PORT automatically)
PORT=5000

# MongoDB Connection String (Atlas or local)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/kilimax?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/kilimax

# JWT Secret for authentication tokens
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Allowed Client URLs for CORS (comma-separated for multiple origins)
# For Vercel production + preview deployments:
CLIENT_URL=https://your-frontend-app.vercel.app,http://localhost:5173
